# Moddy Arena (the moddyarena world jar) on the PUBLIC core: a new player arrives in the prep room, facing the arena.
# tools/play.sh switches the arena on by properties (its world id, its rules file, its module), as a server's launcher
# does; the place is built once at y 63-68 above the flat world.
@intent a new player in Moddy Arena stands in the lit prep room, facing the battle arena control panel and the gate to the walled arena
@world flat seed=1

@step he joins
# the arena's first-join words: worlds/arena.json "intro", which the core says once per player per world
@expect chat Welcome to Moddy Arena within 90s
@expect chat The battle arena control panel is on the wall within 10s

@step the prep room
# the arrival spot: the middle of the prep room, on its plank floor, facing north (yaw 180) toward the arena
@assert execute if entity @s[x=-1,y=63,z=20,dx=2,dy=2,dz=2]
@assert execute at @s if block ~ ~-1 ~ minecraft:oak_planks
@assert execute unless entity @s[y_rotation=-135..135]
# a roof over him, lights in the floor, glass to every side
@assert execute at @s if block ~ ~4 ~ minecraft:spruce_planks
@assert execute if block 3 63 18 minecraft:sea_lantern
@assert execute if block 5 65 21 minecraft:glass
@assert execute if block 5 65 25 minecraft:glass
@wait 2s
@shot prep-room

@step the control panel and the arena beyond the gate
# the gate in the middle of the shared wall, the control panel's board over the rest of it (9-control-panel uses it)
@assert execute if block 0 64 16 minecraft:oak_fence_gate
@assert execute if block -2 65 16 minecraft:black_concrete
@assert execute if entity @e[type=minecraft:text_display,tag=moddyarena_panel_title]
# the start button on its green blocks
@assert execute if block 3 65 17 minecraft:stone_button
@assert execute if block 3 65 16 minecraft:lime_concrete
@assert execute if block 0 63 0 minecraft:smooth_sandstone
@assert execute if block 0 64 -16 minecraft:stone_bricks
@aim look 180 12
@wait 1s
@shot arena-in-view

@step the Champions board on the back wall
# behind him, on the prep room's back wall: its title and the settings it shows (the panel's: no champions yet)
@assert execute if block 0 65 26 minecraft:black_concrete
@assert execute if block -4 67 26 minecraft:black_concrete
@assert execute if entity @e[type=minecraft:text_display,tag=moddyarena_champions_title,nbt={text:{text:"ARENA CHAMPIONS"}}]
@assert execute if entity @e[type=minecraft:text_display,tag=moddyarena_champions_settings,nbt={text:{text:"Normal, 5 waves"}}]
@assert execute if entity @e[type=minecraft:text_display,tag=moddyarena_champions_none,nbt={text:{text:"No champions here yet. Be the first!"}}]
@assert execute unless entity @e[type=minecraft:item_display,tag=moddyarena_champions]
@aim look 0 0
@wait 1s
@shot champions-board
