@click slot 5 right
@click slot 1
@click slot 0 shift
@wait 5t
@key key.keyboard.escape
@expect screen none within 3s
@assert execute if items entity @s container.* minecraft:bucket[count=2]
# under the generator's lava: the dripstone hangs from the block the lava sits on, the cauldron below its tip
# SHORTCUT: a ledge under his island, which a player would build out over the void from its edge
fill -1022 60 -1024 -1020 60 -1022 minecraft:cobblestone
# SHORTCUT: stands on that ledge, right under the generator's lava (getting down there is not what the step tests)
tp @s -1020.5 61 -1023.5 0 -90
@wait 10t
@key key.hotbar.3
@aim pos -1020.5 63.5 -1023.5
@key key.attack hold 30t
@assert execute if block -1021 63 -1024 minecraft:air
@key key.inventory
@click slot 44 shift
@click item "Pointed Dripstone"
@click slot 44
@key key.inventory
@key key.hotbar.9
@aim pos -1020.5 64.02 -1023.5
@key key.use
@wait 5t
@assert execute if block -1021 63 -1024 minecraft:pointed_dripstone[vertical_direction=down]
# SHORTCUT: steps aside on the ledge (walking there is not what the step tests), to put the cauldron where he stood
tp @s -1019.5 61 -1023.5 90 45
@wait 5t
@key key.inventory
@click slot 44 shift
@click item "Cauldron"
@click slot 44
@key key.inventory
@key key.hotbar.9
@aim pos -1020.5 60.98 -1023.5
@key key.use
@wait 5t
@assert execute if block -1021 61 -1024 minecraft:cauldron
@shot dripstone-and-cauldron
# SHORTCUT: lava drips into the cauldron on random ticks, about 20 minutes on average; the game's tick speed is raised
# until it fills, then put back
gamerule randomTickSpeed 400
@repeat 120 until execute if block -1021 61 -1024 minecraft:lava_cauldron
@wait 1s
@end-repeat
gamerule randomTickSpeed 3
@assert execute if block -1021 61 -1024 minecraft:lava_cauldron
@key key.inventory
@click slot 44 shift
@click item "Bucket"
@click slot 44
@key key.inventory
@key key.hotbar.9
@aim pos -1020.5 61.6 -1023.5
@key key.use
@wait 10t
@assert execute if items entity @s container.* minecraft:lava_bucket
# and the generator's lava, scooped with his other bucket
# SHORTCUT: stands beside the generator's lava on his island again (climbing back is not what the step tests)
tp @s -1020.5 66 -1022.5 180 60
@aim pos -1020.5 65.9 -1023.5
@key key.use
@wait 2s
@assert execute if items entity @s container.* minecraft:lava_bucket[count=1]
@assert execute if entity @s[advancements={minecraft:story/lava_bucket=true}]
@shot two-lava-buckets

@step 18 New Friends: two cows, fed wheat from his farm plot, and a calf
# his hotbar into his inventory, so the make lands in a free hotbar slot (a full hotbar sends it to the Wish Bag)
@key key.inventory
@expect screen InventoryScreen within 3s
@click slot 39 shift
@click slot 40 shift
@click slot 41 shift
@click slot 42 shift
@click slot 43 shift
@click slot 44 shift
@key key.inventory
@expect screen none within 3s
# animals land where he looks: on his island's grass
@aim pos -1023.5 65.9 -1020.5
@wait 5t
moddy apprentice two cows
@expect screen Container within 10s
@click slot 0
@expect chat /wishes left/ within 90s
@repeat 20 until execute if entity @e[type=minecraft:cow,distance=..12,limit=2]
@wait 1s
@end-repeat
@assert execute if entity @e[type=minecraft:cow,distance=..12]
@shot two-cows
# wheat from his farm plot: in this test world it went up on the flat ground far below his island, 12 blocks ahead of
# where he looked (goal 12)
# SHORTCUT: stands on his farm plot (getting there is not what the step tests)
tp @s -1021.5 -60 -1006.5 0 30
@wait 1s
@aim pos -1020.5 -59.8 -1006.5
@key key.attack hold 5t
@aim pos -1021.5 -59.8 -1005.5
@key key.attack hold 5t
@aim pos -1020.5 -59.8 -1005.5
@key key.attack hold 5t
@repeat 10 until execute if items entity @s container.* minecraft:wheat
@wait 10t
@end-repeat
@assert execute if items entity @s container.* minecraft:wheat
@shot wheat
# SHORTCUT: back on his island (getting there is not what the step tests)
tp @s -1023.5 66 -1022.5 0 20
@wait 1s
# the wheat to his hand: "Wheat" also matches his wheat seeds, so the seeds go to hotbar 9 first (the last slot a pick
# looks at), then the wheat takes their place and the seeds go back into his inventory as the screen closes
@key key.inventory
@click slot 44 shift
@click item "Wheat Seeds"
@click slot 44
@click item "Wheat"
@click slot 44
@key key.inventory
@key key.hotbar.9
@assert execute if items entity @s weapon.mainhand minecraft:wheat
# each grown cow not yet in love, nearest first, is fed by hand
# (a step toward the one he aims at, so the cow already fed does not stand in the way)
@repeat 12 until execute unless entity @e[type=minecraft:cow,distance=..8,nbt={InLove:0,Age:0}]
@aim entity @e[type=minecraft:cow,distance=..8,sort=nearest,limit=1,nbt={InLove:0,Age:0}] if-present
@key key.forward hold 3t
@aim entity @e[type=minecraft:cow,distance=..8,sort=nearest,limit=1,nbt={InLove:0,Age:0}] if-present
@key key.use
@wait 1s
@end-repeat
@repeat 20 until execute if entity @s[advancements={skyvoid_advancements:overworld/passive_animals=true}]
@wait 1s
@end-repeat
@assert execute if entity @e[type=minecraft:cow,nbt=!{Age:0}]
@assert execute if entity @s[advancements={skyvoid_advancements:overworld/passive_animals=true}]
@shot a-calf
