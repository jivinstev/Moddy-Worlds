@wait 5t
@assert execute if block -1023 66 -1020 minecraft:oak_sapling
@key key.inventory
@click slot 44 shift
@click item "Bone Meal"
@click slot 44
@key key.inventory
@key key.hotbar.9
@repeat 12 until execute if block -1023 66 -1020 minecraft:oak_log
@aim pos -1022.5 66.3 -1019.5
@key key.use
@wait 10t
@end-repeat
@assert execute if block -1023 66 -1020 minecraft:oak_log
@shot new-tree
@key key.hotbar.3
@aim pos -1024.5 69.5 -1020.5
@key key.attack hold 10t
@aim pos -1023.5 69.5 -1020.5
@key key.attack hold 10t
@aim pos -1023.5 69.5 -1019.5
@key key.attack hold 10t
@aim pos -1024.5 70.5 -1020.5
@key key.attack hold 10t
@aim pos -1023.5 70.5 -1020.5
@key key.attack hold 10t
@aim pos -1023.5 70.5 -1019.5
@key key.attack hold 10t
@wait 2s
# SHORTCUT: an oak leaf drops an apple 1 time in 200; when none dropped from the leaves he could reach, he is given one
execute unless items entity @s container.* minecraft:apple run give @s minecraft:apple
@assert execute if entity @s[advancements={skyvoid_advancements:overworld/apple=true}]

