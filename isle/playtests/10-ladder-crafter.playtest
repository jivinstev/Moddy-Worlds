@aim pos -1024.5 69.5 -1020.5
@key key.attack hold 10t
@aim pos -1023.5 69.5 -1020.5
@key key.attack hold 10t
@aim pos -1022.5 69.5 -1020.5
@key key.attack hold 10t
@aim pos -1023.5 69.5 -1019.5
@key key.attack hold 10t
@aim pos -1022.5 69.5 -1019.5
@key key.attack hold 10t
@aim pos -1024.5 69.5 -1021.5
@key key.attack hold 10t
@aim pos -1023.5 69.5 -1021.5
@key key.attack hold 10t
@aim pos -1022.5 69.5 -1021.5
@key key.attack hold 10t
# a new tree: a sapling on the grass of his island's free corner, grown with the bone meal
