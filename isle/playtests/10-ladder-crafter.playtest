tp @s -1023.5 66 -1022.5 0 0
@key key.inventory
@click slot 44 shift
@click item "Stone Pickaxe"
@click slot 44
@key key.inventory
@key key.hotbar.9
# SHORTCUT: monsters appear in the dark only with a player 24 or more blocks away, which on a tiny island means
# standing in the void; a zombie (a helmet against the sun, held still) is summoned beside him instead
summon minecraft:zombie -1021.5 66 -1022.5 {NoAI:1b,Tags:["ladder_mob"],equipment:{head:{id:"minecraft:leather_helmet",count:1}}}
@repeat each @e[tag=ladder_mob] max 30 until execute unless entity {it}
@aim entity {it}
@key key.attack
@wait 15t
@end-repeat
@wait 1s
@assert execute unless entity @e[tag=ladder_mob]
@assert execute if entity @s[advancements={skyvoid_advancements:overworld/mob_farm=true}]
@shot beaten

