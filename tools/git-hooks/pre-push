#!/usr/bin/env bash
# PRE-PUSH: refuse a push whose commits ADD a credential or private work, in a file, a file name or a commit message.
#
# Installed with pre-commit (tools/git-hooks/install.sh). pre-commit sees only what is committed here through it;
# this sees every commit about to leave the machine (one made with --no-verify, a cherry-pick, a rebase, a commit
# from another checkout), with tools/secret-scan.py --commits and tools/leak-scan.py --commits (the built-in rules,
# tools/leak-rules.txt and a configured private forbidden list; a configured list that is missing refuses the push).
# Every commit is scanned on its own, so something added and deleted again in a later commit is still refused: the
# history would carry it. A finding never prints what it matched.
set -uo pipefail
remote="${1:-origin}"
top="$(git rev-parse --show-toplevel)" || exit 1
for f in secret-scan.py secret_patterns.py leak-scan.py; do
    if [ ! -f "$top/tools/$f" ]; then
        echo "pre-push: tools/$f is missing, so nothing can be checked; refusing the push" >&2
        exit 1
    fi
done
args=()
listed="$(git config --get moddy.forbidden || true)"
[ -n "$listed" ] && args=(--forbidden "$listed")
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
rc=0
while read -r _lref lsha _rref rsha; do
    [ -z "${lsha:-}" ] && continue
    [ "$lsha" = "$zero" ] && continue                         # deleting a ref adds nothing
    if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        revs=("$lsha" --not "--remotes=$remote")               # a new ref, or a remote tip we do not hold
    else
        revs=("$rsha..$lsha")
    fi
    python3 "$top/tools/secret-scan.py" --repo "$top" --commits -- "${revs[@]}" >&2 || rc=1
    python3 "$top/tools/leak-scan.py" ${args[@]+"${args[@]}"} --repo "$top" --commits -- "${revs[@]}" >&2 || rc=1
done
if [ "$rc" -ne 0 ]; then
    echo "pre-push: REFUSED. A commit above adds a credential or private work (or the scan could not run). Fix that" >&2
    echo "pre-push: COMMIT (amend or rebase it out): a later commit that deletes it still leaves it in the history." >&2
    echo "pre-push: A real key that reached any commit is rotated first." >&2
fi
exit "$rc"
